# PostgreSQL connection string used by Prisma (see prisma/schema.prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Firebase Admin SDK service account credentials.
# Get these from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
# Paste the "private_key" value from the downloaded JSON as-is (keep the literal \n line breaks).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional, defaults to 3001 if unset (see src/main.ts)
PORT=3001

# Frontend origin allowed by CORS (see src/main.ts). If unset, CORS is wide open (*).
CLIENT_URL="https://your-frontend-domain.com"

# Cloudflare R2 (S3-compatible) storage for photo uploads.
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_PRIVATE_BUCKET_NAME="your-private-bucket-name"
R2_PUBLIC_BUCKET_NAME="your-public-bucket-name"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_PRIVATE_BUCKET_URL="https://your-private-bucket-public-url"
R2_PUBLIC_BUCKET_URL="https://your-public-bucket-public-url"

# Shared secret internal cron endpoints check for (e.g. /internal/photos/reconcile).
CRON_SECRET="__A_LONG_RANDOM_STRING__"

# 64 hex characters (32 bytes) used to AES-256-GCM encrypt payment account secrets
# (e.g. ToyyibPayMerchantAccount.secretKey) at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_ACCOUNT_ENCRYPTION_KEY="__64_HEX_CHARS__"

# ApprovalStatus a new MerchantPaymentPlatformOptions starts as. Set to PENDING once the
# admin approval workflow exists; APPROVED is a temporary bypass until then.
DEFAULT_MERCHANT_PAYMENT_PLATFORM_STATUS="APPROVED"

# ToyyibPay API base URL. Sandbox: https://dev.toyyibpay.com, production: https://toyyibpay.com
# WARNING: the app falls back to the sandbox URL if this is unset — never leave it unset
# in a real deployment, or real bills will silently be created against the sandbox.
TOYYIBPAY_BASE_URL="https://dev.toyyibpay.com"

# Publicly reachable URL ToyyibPay's webhook relay posts callbacks to. Left unset, payments
# only ever resolve via the 15-minute sync sweep, never in real time.
TOYYIBPAY_CALLBACK_URL="https://your-webhook-relay-url"

# Where ToyyibPay redirects the customer back to after paying (separate from CLIENT_URL,
# which is only for CORS — these can diverge, e.g. a specific /checkout/complete route).
# Must point at the frontend's /toyyib-payment-return-url page, which re-triggers a payment
# sync as a safety net in case the webhook callback never arrives.
TOYYIBPAY_RETURN_URL="https://your-frontend-domain.com/toyyib-payment-return-url"
