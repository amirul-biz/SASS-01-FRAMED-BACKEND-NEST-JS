datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "commonjs"
}

enum UserRole {
  PHOTOGRAPHER
  ADMIN

  @@map("user_role")
}

enum EventCategory {
  CYCLING
  RUNNING
  SWIMMING
  TRIATHLON
  MOTORSPORT
  OTHER

  @@map("event_category")
}

enum PhotoUploadStatus {
  PENDING
  UPLOADED
  FAILED

  @@map("photo_upload_status")
}

model User {
  id            String         @id @default(uuid())
  firebaseId    String         @unique @map("firebase_id")
  email         String         @unique
  createdAt     DateTime       @default(now()) @map("created_at")
  userPlatforms UserPlatform[]

  @@map("users")
}

model UserPlatform {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")

  photographerProfile PhotographerProfile?
  adminProfile        AdminProfile?

  @@unique([userId, role])
  @@index([userId], map: "idx_user_platforms_user")
  @@map("user_platforms")
}

model PhotographerProfile {
  id              String       @id @default(uuid())
  userPlatformId  String       @unique @map("user_platform_id")
  userPlatform    UserPlatform @relation(fields: [userPlatformId], references: [id], onDelete: Cascade)
  name            String
  bio             String?
  companyName     String?      @map("company_name")
  phone           String?
  contactNo       String?      @map("contact_no")
  profileImageUrl String?      @map("profile_image_url")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  events Event[]

  @@map("photographer_profiles")
}

model Event {
  id                  String              @id @default(uuid())
  photographerId      String              @map("photographer_id")
  photographerProfile PhotographerProfile @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  title               String              @db.VarChar(255)
  description         String?
  category            EventCategory
  location            String?             @db.VarChar(255)
  eventStartDate      DateTime            @map("event_start_date") @db.Timestamptz(6)
  eventEndDate        DateTime            @map("event_end_date") @db.Timestamptz(6)
  isPublished         Boolean             @default(false) @map("is_published")
  publishedAt         DateTime?           @map("published_at") @db.Timestamptz(6)
  coverPhotoUrl       String?             @map("cover_photo_url")
  deletedAt           DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  photos Photo[]

  @@index([photographerId], map: "idx_events_photographer")
  @@index([isPublished, eventStartDate(sort: Desc)], map: "idx_events_published")
  @@map("events")
}

model Photo {
  id                String            @id @default(uuid())
  eventId           String            @map("event_id")
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  key               String            @unique
  originalName      String            @map("original_name")
  mimeType          String            @map("mime_type")
  sizeBytes         Int?              @map("size_bytes")
  width             Int?
  height            Int?
  status            PhotoUploadStatus @default(PENDING)
  capturedAt        DateTime?         @map("captured_at")
  isEventAlbumCover Boolean           @default(false) @map("is_event_album_cover")
  uploadedAt        DateTime?         @map("uploaded_at")
  deletedAt         DateTime?         @map("deleted_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([eventId, status], map: "idx_photos_event_status")
  @@map("photos")
}

model AdminProfile {
  id             String       @id @default(uuid())
  userPlatformId String       @unique @map("user_platform_id")
  userPlatform   UserPlatform @relation(fields: [userPlatformId], references: [id], onDelete: Cascade)
  name           String
  permissions    Json         @default("[]")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("admin_profiles")
}
